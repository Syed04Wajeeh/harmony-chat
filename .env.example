NODE_ENV=production
LOG_LEVEL=info

POSTGRES_USER=harmony
POSTGRES_PASSWORD=change-me
POSTGRES_DB=harmony

# Shared by nginx and the app (at least 32 chars). Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=change-me-to-a-random-value-of-32-chars-or-more
# Exact origin browsers use to reach the app (Tailscale Serve URL).
PUBLIC_ORIGIN=https://chat.example.ts.net:18470
# Optional: comma-separated Tailscale logins allowed in. Empty allows any tailnet user.
ALLOWED_LOGINS=
# Optional: identifies this instance in logs and the WebSocket hello frame.
INSTANCE_ID=app-1
# Optional: largest accepted upload in bytes (default 10485760 = 10 MiB). nginx allows 11m on
# /api/uploads; raise client_max_body_size in deploy/nginx/default.conf.template if you raise this.
# UPLOAD_MAX_BYTES=10485760

# Optional: hostnames, IPs or CIDRs that bots owned by an instance admin may call on private
# networks (comma-separated). Empty by default: bots can only reach public addresses.
# OUTBOUND_PRIVATE_ALLOWLIST=
