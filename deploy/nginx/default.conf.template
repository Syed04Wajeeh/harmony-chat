upstream harmony_app {
    server app:8080;
    keepalive 16;
}

# Empty Connection keeps the upstream connection reusable for plain requests.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 1m;

    # Declared once at server level: nginx drops inherited proxy_set_header directives as
    # soon as a location declares its own, so locations below must not add any.
    # Tailscale-* and X-Forwarded-* arrive from Tailscale Serve and are passed through
    # untouched. The secret header overwrites any client-sent copy.
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Harmony-Proxy-Secret "${PROXY_SHARED_SECRET}";

    location /api/ws {
        proxy_pass http://harmony_app;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Uploads may be larger than the 1m default. The app enforces the real limit
    # (UPLOAD_MAX_BYTES, default 10 MiB); keep this above it to allow for multipart overhead.
    # The location sets no proxy_set_header of its own, so the server-level ones, including
    # the proxy secret, still apply.
    location = /api/uploads {
        client_max_body_size 11m;
        proxy_pass http://harmony_app;
    }

    location / {
        proxy_pass http://harmony_app;
    }
}

# Bots only react to Authorization headers; this lets us route on them without ever
# treating a lookalike scheme (Bearer, Basic) as one.
map $http_authorization $harmony_bot_request {
    default       0;
    "~*^bot\s+\S" 1;
}

# Integration ingress for host-local scripts, published on 127.0.0.1 only. It carries exactly
# three kinds of traffic: incoming webhooks, interaction follow-ups (both credentialed by a token
# in the path) and requests that present `Authorization: Bot`. It never adds the proxy secret and
# blanks every identity header, so nothing arriving here can ever act as a human.
#
# As above, proxy_set_header lives at server level only: a location that declares its own would
# silently drop all of these.
server {
    listen 8081;
    server_name _;

    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Harmony-Proxy-Secret "";
    proxy_set_header Tailscale-User-Login "";
    proxy_set_header Tailscale-User-Name "";
    proxy_set_header Tailscale-User-Profile-Pic "";
    proxy_set_header Tailscale-Funnel-Request "";
    proxy_set_header Tailscale-Headers-Info "";
    proxy_set_header Tailscale-App-Capabilities "";

    location /api/webhooks/ {
        if ($request_method != POST) { return 404; }
        proxy_pass http://harmony_app;
    }

    location /api/interactions/ {
        if ($request_method != POST) { return 404; }
        proxy_pass http://harmony_app;
    }

    location /api/ws {
        if ($harmony_bot_request = 0) { return 404; }
        proxy_pass http://harmony_app;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /api/ {
        if ($harmony_bot_request = 0) { return 404; }
        proxy_pass http://harmony_app;
    }

    location / {
        return 404;
    }
}
