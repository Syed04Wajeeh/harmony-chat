{
  "name": "@harmony/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that lets agents talk to people in Harmony through a bot token",
  "private": true,
  "type": "module",
  "bin": {
    "harmony-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@harmony/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
